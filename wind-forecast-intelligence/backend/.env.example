# Copy to .env (never commit .env). The Elexon Insights API needs no key. Defaults shown.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
HTTP_CONNECT_TIMEOUT_S=10
HTTP_READ_TIMEOUT_S=60
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_S=1.5
DELIVERY_START=2026-01-01
DELIVERY_END=2026-01-31
# PROVISIONAL decision cutoff: local time on (delivery date - CUTOFF_DAYS_BEFORE). Not a confirmed utility deadline.
CUTOFF_TIME=09:20
CUTOFF_DAYS_BEFORE=1
TIMEZONE=Europe/London
# "start": forecast stamped t covers actual slots t and t+30m. "end": slots t-60m and t-30m.
HOUR_CONVENTION=start
PUBLISH_LEAD_IN_DAYS=3
PUBLISH_LEAD_OUT_DAYS=1
FORECAST_CHUNK_DAYS=3
ACTUAL_CHUNK_DAYS=10
MIN_HOUR_OF_DAY_SAMPLES=10
ERROR_BIN_WIDTH_MW=500
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AUTO_INGEST_ON_START=false
LOG_LEVEL=INFO
